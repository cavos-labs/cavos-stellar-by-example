# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# App ID of your application in the Cavos dashboard (https://cavos.xyz/dashboard).
# Public by design.
NEXT_PUBLIC_CAVOS_APP_ID=

# Any string that names your app, for example "stellar-wallet-starter".
# It is part of how each user's account is derived. Choose it once and never
# change it after users have signed in, or they land on new, empty wallets.
NEXT_PUBLIC_CAVOS_APP_SALT=
